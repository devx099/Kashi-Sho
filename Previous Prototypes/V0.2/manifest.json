{
  "manifest_version": 3,
  "name": "Global YouTube Lyrics HUD",
  "version": "0.2",
  "description": "Displays YouTube music lyrics in a persistent HUD across all tabs.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["youtube-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["hud-script.js"],
      "css": ["hud-style.css"],
      "run_at": "document_end"
    }
  ]
}