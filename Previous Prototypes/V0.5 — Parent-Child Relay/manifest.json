{
  "manifest_version": 3,
  "name": "Global YouTube Lyrics HUD",
  "version": "0.5",
  "description": "Distributed synchronized lyric HUD.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["youtube-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["hud-script.js"],
      "css": ["hud-style.css"],
      "run_at": "document_idle"
    }
  ]
}