{
  "manifest_version": 3,
  "name": "Global YouTube Lyrics HUD",
  "version": "0.3",
  "description": "Persistent synchronized caption HUD.",
  "permissions": [
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["youtube-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["hud-script.js"],
      "css": ["hud-style.css"],
      "run_at": "document_end"
    }
  ]
}